# --- Секреты ---
.env
.env.*
!.env.example

# --- Данные пользователей и БД ---
users.db
users.db-journal
users.db.bak*

# --- Генерируемые в рантайме артефакты ---
# timetable.json         — кэш расписания всех групп
# timetable.meta.json    — метка времени загрузки кэша (TTL)
# first_day.json         — автоопределённый FIRST_DAY (см. timetable_cache.get_first_day)
# timetable*.png         — отрисованные картинки расписания
#                          (personal: timetable_personal_<hash>.png;
#                           group:    timetable_<group>_week_<N>_<hash>.png)
# debug_dumps/           — HTML-дампы страниц ЛК для отладки парсеров
timetable.json
timetable.meta.json
first_day.json
timetable*.png
debug_dumps/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# --- Тесты и покрытие ---
.coverage
.coverage.*
.pytest_cache/
htmlcov/

# --- Редакторы и ОС ---
.vscode/
.idea/
.DS_Store
*.swp
